{
  "name": "get-fork",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "check": "wrangler check",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "node --experimental-strip-types --test src/shared/*.test.ts",
    "setup": "wrangler d1 migrations apply fork --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.37.0"
  }
}
